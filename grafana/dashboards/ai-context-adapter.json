{
  "uid": "ai-context-adapter",
  "title": "ai-context adapter: tool latency per project",
  "tags": [
    "ai-monitoring",
    "ai-context"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Projects",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "type": "query",
        "query": {
          "query": "label_values(opencode_tool_duration_milliseconds_count{service_name=\"ai-context\"},project)",
          "refId": "v"
        },
        "definition": "label_values(opencode_tool_duration_milliseconds_count{service_name=\"ai-context\"},project)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tool",
        "label": "Tool",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "type": "query",
        "query": {
          "query": "label_values(opencode_tool_duration_milliseconds_count{service_name=\"ai-context\",project=~\"$project\"},tool)",
          "refId": "v"
        },
        "definition": "label_values(opencode_tool_duration_milliseconds_count{service_name=\"ai-context\",project=~\"$project\"},tool)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "group",
        "label": "Group by",
        "type": "custom",
        "query": "Tool : tool,Project : project,Instance : service_instance_id",
        "current": {
          "text": "Tool",
          "value": "tool"
        },
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "resolution",
        "label": "Resolution",
        "type": "interval",
        "query": "1m,5m,15m,30m,1h,3h,6h,12h,1d",
        "auto": true,
        "auto_count": 30,
        "auto_min": "1m",
        "current": {
          "text": "auto",
          "value": "$__auto"
        },
        "options": [],
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 201,
      "type": "row",
      "title": "Tool categories: ai-context vs MCP vs base",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 202,
      "type": "timeseries",
      "title": "ai-context tool calls over time",
      "description": "semantic_search, repo_structure, analyze_impact, find_symbol, search_docs, index_status, ai_context_*",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (tool) (increase(opencode_tool_duration_milliseconds_count{service_name=\"ai-context\",project=~\"$project\",tool=~\"$tool\",tool=~\"semantic_search|repo_structure|analyze_impact|find_symbol|search_docs|index_status|ai_context_.+\"}[$__interval]))",
          "legendFormat": "{{tool}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "$resolution"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "barWidthFactor": 0.9,
            "lineWidth": 0,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
