{
  "uid": "ai-monitoring-projects",
  "title": "AI usage: per project overview",
  "tags": [
    "ai-monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 27,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Projects",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "query_result(group by (project) (last_over_time(gen_ai_client_token_usage_sum{project!=\"\"}[30d])))",
          "refId": "v"
        },
        "definition": "query_result(group by (project) (last_over_time(gen_ai_client_token_usage_sum{project!=\"\"}[30d])))",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 5,
        "description": "All projects get a row by default. Pick specific projects to show only those; remove a row with the x on its chip.",
        "regex": "/project=\"([^\"]*)\"/"
      },
      {
        "name": "shown",
        "label": "Shown projects",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "hide": 2,
        "query": {
          "query": "query_result(group by (project) (last_over_time(gen_ai_client_token_usage_sum{project=~\"$project\"}[30d])))",
          "refId": "v"
        },
        "definition": "query_result(group by (project) (last_over_time(gen_ai_client_token_usage_sum{project=~\"$project\"}[30d])))",
        "regex": "/project=\"([^\"]*)\"/",
        "refresh": 2,
        "sort": 5,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(gen_ai_client_token_usage_sum,gen_ai_provider_name)",
          "refId": "v"
        },
        "definition": "label_values(gen_ai_client_token_usage_sum,gen_ai_provider_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(gen_ai_client_token_usage_sum{gen_ai_provider_name=~\"$provider\"},gen_ai_request_model)",
          "refId": "v"
        },
        "definition": "label_values(gen_ai_client_token_usage_sum{gen_ai_provider_name=~\"$provider\"},gen_ai_request_model)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "agent",
        "label": "Agent",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(gen_ai_client_token_usage_sum{gen_ai_provider_name=~\"$provider\"},gen_ai_agent_name)",
          "refId": "v"
        },
        "definition": "label_values(gen_ai_client_token_usage_sum{gen_ai_provider_name=~\"$provider\"},gen_ai_agent_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "resolution",
        "label": "Resolution",
        "type": "interval",
        "query": "1m,5m,15m,30m,1h,3h,6h,12h,1d",
        "auto": true,
        "auto_count": 30,
        "auto_min": "1m",
        "current": {
          "text": "auto",
          "value": "$__auto"
        },
        "options": [],
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Total (all projects)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 109,
      "type": "timeseries",
      "title": "Tokens over time by model",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 7,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "label_replace(sum by (gen_ai_request_model) (increase(gen_ai_client_token_usage_sum{gen_ai_provider_name=~\"$provider\",gen_ai_request_model=~\"$model\",gen_ai_agent_name=~\"$agent\"}[$__interval])), \"gen_ai_request_model\", \"(none)\", \"gen_ai_request_model\", \"^$\")",
          "legendFormat": "{{gen_ai_request_model}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "$resolution"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^sonnet 5\\.5$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^claude-([a-z]+)-(\\d+)(?:[-.](\\d{1,2}))(?:-\\d{8})?$",
            "renamePattern": "$1 $2.$3"
          }
        }
      ]
    },
