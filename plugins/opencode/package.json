{
  "name": "opencode-ai-monitoring",
  "version": "0.3.0",
  "description": "OpenCode (1 and 2) plugin that exports token usage as OpenTelemetry GenAI metrics",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/ai-monitoring.js"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.0",
    "@opencode/plugin": "2.2.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "main": "src/index.ts"
}
